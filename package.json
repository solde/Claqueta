{
  "name": "claqueta",
  "version": "1.0.3",
  "private": true,
  "type": "module",
  "description": "Claqueta: TV/radio/podcast production suite, offline desktop app for macOS, Windows and Linux",
  "engines": {
    "node": ">=24.7"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "vendor": "node scripts/vendor.mjs",
    "desktop": "node scripts/vendor.mjs && electron .",
    "desktop:smoke": "node scripts/vendor.mjs && electron . --smoke-test=.scratch/smoke.png",
    "icons": "electron scripts/make-icons.mjs",
    "dist": "node scripts/vendor.mjs && electron-builder",
    "dist:mac": "node scripts/vendor.mjs && electron-builder --mac",
    "dist:win": "node scripts/vendor.mjs && electron-builder --win",
    "dist:linux": "node scripts/vendor.mjs && electron-builder --linux",
    "release": "node scripts/publish-release.mjs"
  },
  "dependencies": {
    "@lydell/node-pty": "1.1.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "qrcode-generator": "1.4.4",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3"
  },
  "main": "desktop/main.mjs",
  "author": {
    "name": "Collado",
    "email": "david.soldevila1@gmail.com"
  },
  "homepage": "https://gitea.solde.cat/dsoldevila/claqueta-desktop",
  "build": {
    "appId": "cat.solde.claqueta",
    "productName": "Claqueta",
    "copyright": "Claqueta",
    "asar": false,
    "compression": "normal",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "desktop/**/*",
      "gateway/**/*",
      "app-seed/**/*",
      "tools/**/*",
      "package.json",
      "!gateway/tmux.conf",
      "!**/*.map",
      "!node_modules/@xterm/**",
      "!node_modules/qrcode-generator/**",
      "!**/.DS_Store"
    ],
    "mac": {
      "category": "public.app-category.business",
      "target": [
        "dmg",
        "zip"
      ],
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-win-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "artifactName": "${productName}-${version}-win-${arch}-setup.${ext}"
    },
    "linux": {
      "category": "Office",
      "target": [
        "AppImage",
        "deb"
      ],
      "maintainer": "Claqueta <david.soldevila1@gmail.com>",
      "synopsis": "Gestión de producción de TV, radio y podcast",
      "artifactName": "${productName}-${version}-linux-${arch}.${ext}"
    },
    "electronLanguages": [
      "es",
      "ca",
      "en-US",
      "en-GB"
    ],
    "portable": {
      "artifactName": "${productName}-${version}-win-${arch}-portable.${ext}"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://gitea.solde.cat/dsoldevila/claqueta-desktop.git"
  }
}
